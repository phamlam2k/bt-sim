      }
    ]
  },
  {
    "id": "manager_sec",
    "day": 2,
    "when": {
      "type": "reviewed",
      "puzzle": "cr-201"
    },
    "channel": "dm-rohan",
    "from": "rohan",
    "messages": [
      {
        "text": "got a sec?",
        "afterMinutes": 2
      },
      {
        "text": "Nothing scary. I do a 15-minute sync with new folks in their first week. Now, or after the review you are on?",
        "afterMinutes": 6
      }
    ],
    "replies": [
      {
        "id": "now",
        "text": "Now works.",
        "effects": [
          {
            "type": "time",
            "minutes": 15
          },
          {
            "type": "stat",
            "path": "stats.flow",
            "delta": -100
          },
          {
            "type": "stat",
            "path": "trust.rohan",
            "delta": 3
          },
          {
            "type": "stat",
            "path": "hidden.credit",
            "delta": 1
          }
        ],
        "followUp": "Good chat. The one thing to remember: bring me bad news early. Early, I can fix."
      },
      {
        "id": "after",
        "text": "After this review, if that's ok. I'm in the middle of reading it.",
        "effects": [
          {
            "type": "stat",
            "path": "trust.rohan",
            "delta": 2
          }
        ],
        "followUp": "Good. Finish your thought first. Come find me later."
      }
    ],
    "expiresAfterMinutes": 120,
    "onIgnored": [
      {
        "type": "stat",
        "path": "trust.rohan",
        "delta": -5
      },
      {
        "type": "stat",
        "path": "stats.stress",
        "delta": 5
      }
    ]
  },
  {
    "id": "day2_end",
    "day": 2,
    "when": {
      "type": "reviewed",
      "puzzle": "cr-202"
    },
    "channel": "dm-maya",
    "from": "maya",
    "messages": [
      {
        "text": "Two reviews in. One had a real problem, one was clean. Telling those apart is the whole skill. Head home, and tomorrow we do ones where you read the code.",
        "afterMinutes": 2
      }
    ]
  },
  {
    "id": "d3_morning",
    "day": 3,
    "when": {
      "type": "time",
      "atLeast": "09:00"
    },
    "channel": "dm-maya",
    "from": "maya",
    "messages": [
      {
        "text": "Three CRs in your queue today, and these need you to read the code.",
        "afterMinutes": 1
      },
      {
        "text": "Hover any line to get it in plain English, and ask me for hints. That is what they are for. Nobody reads code fluently in week one.",
        "afterMinutes": 3
      }
    ],
    "replies": [
      {
        "id": "go",
        "text": "On it.",
        "effects": [
          {
            "type": "flag",
            "id": "d3_ready",
            "value": true
          },
          {
            "type": "step",
            "step": "chat:d3"
          }
        ],
        "followUp": "First one is from Priya."
      }
    ]
  },
  {
    "id": "priya_rush",
    "day": 3,
    "when": {
      "type": "flag",
      "id": "d3_ready",
      "is": true
    },
    "channel": "dm-priya",
    "from": "priya",
    "messages": [
      {
        "text": "hey! just sent you a CR for the billing price lookup. it's tiny. could you approve it quick? I want it in before lunch 🙏",
        "afterMinutes": 3
      }
    ],
    "replies": [
      {
        "id": "properly",
        "text": "I'll look now, but I'm going to read it properly.",
        "effects": [
          {
            "type": "stat",
            "path": "trust.priya",
            "delta": 1
          }
        ],
        "followUp": "fair. that's what I'd say too tbh"
      },
      {
        "id": "sure",
        "text": "Sure, on it.",
        "effects": [
          {
            "type": "stat",
            "path": "trust.priya",
            "delta": 2
          }
        ],
        "followUp": "you're the best"
      }
    ]
  },
  {
    "id": "maya_checkin",
    "day": 3,
    "when": {
